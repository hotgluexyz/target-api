    "version": "0.2.0",
    "configurations": [
        {
            "name": "target-api",
            "type": "python",
            "request": "launch",
            "justMyCode": false,
            "program": "../target_api/target.py",
            "cwd": "${workspaceFolder}/.secrets",
            "args": [
                "<",
                "data.singer",
                "--config",
                "config.json",
                ">",
                "state.json"
            ],
            "env": {
                "STREAMING_JOB": "True"
            },
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python"
        }
    ]
}